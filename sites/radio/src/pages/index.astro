---
import BaseLayout from '../layouts/BaseLayout.astro';
import CoverageMap from '../components/CoverageMap.astro';
---

<BaseLayout>
  <div class="flex flex-col md:flex-row flex-1 min-h-0 overflow-hidden">
    <!-- Sidebar -->
    <aside id="sidebar" class="w-full md:w-80 bg-white border-b md:border-b-0 md:border-r border-gray-200 p-5 flex flex-col gap-5 overflow-y-auto shrink-0 shadow-sm z-10">
      
      <!-- Network Status Card -->
      <div class="bg-gray-50 border border-gray-100 rounded-lg p-4 shadow-sm">
        <div class="flex items-center justify-between mb-2">
          <h2 class="font-bold text-gray-900 tracking-tight text-sm uppercase">Stuart Ave Base</h2>
          <span class="flex items-center gap-1.5 text-xs text-green-700 bg-green-50 px-2 py-0.5 rounded-full font-medium border border-green-200">
            <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
            Active
          </span>
        </div>
        <div class="space-y-1.5 text-xs text-gray-600">
          <div class="flex justify-between"><span class="text-gray-400">Frequency:</span> <span class="font-mono font-medium">462.575 MHz</span></div>
          <div class="flex justify-between"><span class="text-gray-400">GMRS Ch:</span> <span class="font-medium">Ch 16</span></div>
          <div class="flex justify-between"><span class="text-gray-400">Coordinates:</span> <span class="font-mono">37.5555, -77.4691</span></div>
        </div>
      </div>

      <!-- Layer Toggles -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider">Map Layers</h3>
        <div class="space-y-2.5">
          <label class="flex items-center gap-3 cursor-pointer text-sm text-gray-700 hover:text-gray-900 font-medium">
            <input type="checkbox" id="toggle-simplex" class="w-4 h-4 rounded text-blue-600 border-gray-300 focus:ring-blue-500" checked />
            <span class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-blue-500"></span>
              Simplex Range
            </span>
          </label>
          
          <label class="flex items-center gap-3 cursor-pointer text-sm text-gray-700 hover:text-gray-900 font-medium">
            <input type="checkbox" id="toggle-repeater" class="w-4 h-4 rounded text-green-600 border-gray-300 focus:ring-green-500" checked />
            <span class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-green-500"></span>
              Repeater Range
            </span>
          </label>

          <label class="flex items-center gap-3 cursor-pointer text-sm text-gray-700 hover:text-gray-900 font-medium">
            <input type="checkbox" id="toggle-buildings" class="w-4 h-4 rounded text-gray-600 border-gray-300 focus:ring-gray-500" checked />
            <span class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded bg-slate-300 border border-slate-400"></span>
              Building Outlines
            </span>
          </label>

          <label class="flex items-center gap-3 cursor-pointer text-sm text-gray-700 hover:text-gray-900 font-medium">
            <input type="checkbox" id="toggle-reports" class="w-4 h-4 rounded text-amber-600 border-gray-300 focus:ring-amber-500" checked />
            <span class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-amber-500 ring-2 ring-white"></span>
              User Signal Reports
            </span>
          </label>

          <label class="flex items-center gap-3 cursor-pointer text-sm text-gray-700 hover:text-gray-900 font-medium">
            <input type="checkbox" id="toggle-custom-station" class="w-4 h-4 rounded text-pink-600 border-gray-300 focus:ring-pink-500" />
            <span class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-pink-500"></span>
              My Custom Station
            </span>
          </label>
        </div>
      </div>

      <!-- Radio Hardware Settings (collapsible) -->
      <div class="border-t border-gray-100 pt-4 space-y-3">
        <button id="toggle-hw-settings" class="flex items-center justify-between w-full text-xs font-bold text-gray-400 uppercase tracking-wider group cursor-pointer">
          <span>⚙️ Radio Hardware Settings</span>
          <svg id="hw-chevron" class="w-4 h-4 text-gray-400 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </button>
        <div id="hw-settings-panel" class="space-y-4 hidden">
          
          <!-- Simplex Handheld -->
          <div class="bg-blue-50 border border-blue-100 rounded-lg p-3 space-y-2.5">
            <h4 class="text-xs font-bold text-blue-800 uppercase tracking-wide">Simplex Handheld</h4>
            
            <div>
              <div class="flex justify-between text-[11px] text-gray-600 mb-1">
                <span>TX Power</span>
                <span class="font-mono font-semibold text-blue-700" id="simplex-power-val">5.0W</span>
              </div>
              <input type="range" id="simplex-power" min="0.5" max="5" step="0.5" value="5" class="w-full h-1.5 bg-blue-200 rounded-lg appearance-none cursor-pointer accent-blue-600" />
            </div>

            <div>
              <div class="flex justify-between text-[11px] text-gray-600 mb-1">
                <span>Antenna Height</span>
                <span class="font-mono font-semibold text-blue-700" id="simplex-height-val">1.5m</span>
              </div>
              <input type="range" id="simplex-height" min="1.0" max="3.0" step="0.1" value="1.5" class="w-full h-1.5 bg-blue-200 rounded-lg appearance-none cursor-pointer accent-blue-600" />
            </div>

            <div>
              <div class="flex justify-between text-[11px] text-gray-600 mb-1">
                <span>Antenna Gain</span>
                <span class="font-mono font-semibold text-blue-700" id="simplex-gain-val">2.0 dBi</span>
              </div>
              <input type="range" id="simplex-gain" min="-3" max="6" step="0.5" value="2" class="w-full h-1.5 bg-blue-200 rounded-lg appearance-none cursor-pointer accent-blue-600" />
            </div>
          </div>

          <!-- Repeater Base -->
          <div class="bg-green-50 border border-green-100 rounded-lg p-3 space-y-2.5">
            <h4 class="text-xs font-bold text-green-800 uppercase tracking-wide">Repeater Base</h4>

            <div>
              <div class="flex justify-between text-[11px] text-gray-600 mb-1">
                <span>TX Power</span>
                <span class="font-mono font-semibold text-green-700" id="repeater-power-val">50W</span>
              </div>
              <input type="range" id="repeater-power" min="5" max="50" step="5" value="50" class="w-full h-1.5 bg-green-200 rounded-lg appearance-none cursor-pointer accent-green-600" />
            </div>

            <div>
              <div class="flex justify-between text-[11px] text-gray-600 mb-1">
                <span>Antenna Height</span>
                <span class="font-mono font-semibold text-green-700" id="repeater-height-val">12.0m</span>
              </div>
              <input type="range" id="repeater-height" min="5" max="25" step="0.5" value="12" class="w-full h-1.5 bg-green-200 rounded-lg appearance-none cursor-pointer accent-green-600" />
            </div>

            <div>
              <div class="flex justify-between text-[11px] text-gray-600 mb-1">
                <span>Antenna Gain</span>
                <span class="font-mono font-semibold text-green-700" id="repeater-gain-val">3.0 dBi</span>
              </div>
              <input type="range" id="repeater-gain" min="0" max="10" step="0.5" value="3" class="w-full h-1.5 bg-green-200 rounded-lg appearance-none cursor-pointer accent-green-600" />
            </div>
          </div>

          <!-- Propagation Tuning -->
          <div class="bg-gray-50 border border-gray-200 rounded-lg p-3 space-y-2.5">
            <h4 class="text-xs font-bold text-gray-700 uppercase tracking-wide">Propagation Tuning</h4>

            <div>
              <div class="flex justify-between text-[11px] text-gray-600 mb-1">
                <span>Urban Clutter Loss</span>
                <span class="font-mono font-semibold text-gray-700" id="clutter-loss-val">20 dB</span>
              </div>
              <input type="range" id="clutter-loss" min="0" max="60" step="1" value="45" class="w-full h-1.5 bg-gray-300 rounded-lg appearance-none cursor-pointer accent-gray-600" />
              <p class="text-[10px] text-gray-400 mt-1 leading-tight">Lower this if your local tests show better range than the map predicts.</p>
            </div>

            <div class="bg-amber-50 border border-amber-200 rounded p-2">
              <p class="text-[10px] text-amber-800 leading-tight">
                <strong>Pro tip:</strong> Drop a 📍 pin on the map at a location you've tested. Adjust the settings above until the pin's predicted RSSI matches your real-world experience, then click <strong>Recalculate</strong> to update the coverage rings.
              </p>
            </div>
          </div>

          <button id="recalculate-coverage" class="w-full py-2 px-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-xs font-semibold tracking-wide transition flex items-center justify-center gap-1.5 shadow-sm">
            🔄 Recalculate Coverage
          </button>
          <p id="recalc-status" class="text-[10px] text-gray-400 text-center hidden">Recalculating…</p>
        </div>
      </div>

      <!-- Coverage Legend -->
      <div class="border-t border-gray-100 pt-4 space-y-3">
        <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider">Signal Strength Scale</h3>
        <div class="grid grid-cols-2 gap-x-2 gap-y-1.5 text-[11px] leading-tight text-gray-600">
          <div class="font-semibold text-gray-700 mb-0.5">Simplex (Blue)</div>
          <div class="font-semibold text-gray-700 mb-0.5">Repeater (Green)</div>
          
          <div class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-sm bg-[#2563eb] opacity-80 border border-[#1d4ed8]"></span>
            <span>Strong (> -90 dBm)</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-sm bg-[#16a34a] opacity-80 border border-[#15803d]"></span>
            <span>Strong (> -90 dBm)</span>
          </div>
          
          <div class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-sm bg-[#3b82f6] opacity-80 border border-[#2563eb]"></span>
            <span>Usable (> -105)</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-sm bg-[#22c55e] opacity-80 border border-[#16a34a]"></span>
            <span>Usable (> -105)</span>
          </div>
          
          <div class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-sm bg-[#93c5fd] opacity-80 border border-[#60a5fa]"></span>
            <span>Fringe (> -115)</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-sm bg-[#86efac] opacity-80 border border-[#4ade80]"></span>
            <span>Fringe (> -115)</span>
          </div>
        </div>
      </div>

      <!-- Estimation Toolbox -->
      <div class="border-t border-gray-100 pt-4 space-y-3">
        <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider">Signal Estimation</h3>
        <p class="text-xs text-gray-500 leading-relaxed">
          Click anywhere on the map to drop a pin and estimate the signal strength. Drag pins to update, or clear them all.
        </p>
        <button id="clear-pins" class="w-full py-2 px-3 border border-red-200 text-red-700 bg-red-50 hover:bg-red-100 rounded-lg text-xs font-semibold tracking-wide transition flex items-center justify-center gap-1.5 shadow-sm">
          🗑️ Clear User Pins
        </button>
      </div>

      <!-- My Channel Settings (collapsible) -->
      <div class="border-t border-gray-100 pt-4 space-y-3">
        <button id="toggle-channel-settings" class="flex items-center justify-between w-full text-xs font-bold text-gray-400 uppercase tracking-wider group cursor-pointer">
          <span>📻 My Channel Settings</span>
          <svg id="channel-chevron" class="w-4 h-4 text-gray-400 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </button>
        <div id="channel-settings-panel" class="space-y-2.5 hidden">
          <div>
            <label class="block text-[11px] text-gray-500 mb-0.5">Station / Call Name</label>
            <input type="text" id="channel-name" placeholder="e.g. KD4ABC" class="w-full rounded border-gray-300 border px-2.5 py-1.5 text-xs shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
          </div>
          <div>
            <label class="block text-[11px] text-gray-500 mb-0.5">Channel</label>
            <input type="text" id="channel-ch" placeholder="e.g. GMRS 16 (462.575)" class="w-full rounded border-gray-300 border px-2.5 py-1.5 text-xs shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-[11px] text-gray-500 mb-0.5">TX Tone</label>
              <input type="text" id="channel-tx-tone" placeholder="e.g. 100.0 Hz" class="w-full rounded border-gray-300 border px-2.5 py-1.5 text-xs shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
            </div>
            <div>
              <label class="block text-[11px] text-gray-500 mb-0.5">RX Tone</label>
              <input type="text" id="channel-rx-tone" placeholder="e.g. OFF" class="w-full rounded border-gray-300 border px-2.5 py-1.5 text-xs shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
            </div>
          </div>
          <div>
            <label class="block text-[11px] text-gray-500 mb-0.5">Notes</label>
            <textarea id="channel-notes" rows="2" placeholder="e.g. Active evenings, monitoring 24/7" class="w-full rounded border-gray-300 border px-2.5 py-1.5 text-xs shadow-sm focus:border-indigo-500 focus:ring-indigo-500"></textarea>
          </div>
          <button id="generate-share-link" class="w-full py-2 px-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-xs font-semibold tracking-wide transition flex items-center justify-center gap-1.5 shadow-sm">
            🔗 Generate Share Link
          </button>
          <p id="share-status" class="text-[10px] text-green-600 text-center hidden">Link copied to clipboard!</p>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="border-t border-gray-100 pt-4 mt-auto flex flex-col gap-2">
        <a href="/programming" class="py-2.5 px-4 bg-amber-500 hover:bg-amber-400 text-white rounded-lg text-sm font-semibold tracking-wide shadow transition text-center flex items-center justify-center gap-2">
          📖 Radio Programming Guide
        </a>
        <a href="/report" class="py-2.5 px-4 bg-gray-900 hover:bg-gray-800 text-white rounded-lg text-sm font-semibold tracking-wide shadow transition text-center flex items-center justify-center gap-2">
          📡 Report Signal Quality
        </a>
      </div>

    </aside>

    <!-- Map Container -->
    <main class="flex-1 min-h-[400px] relative bg-slate-100 h-full">
      <CoverageMap class="w-full h-full" />
    </main>
  </div>
</BaseLayout>