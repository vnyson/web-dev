{
  "name": "tennis-admin-api",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Workers API for tennis admin system",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create tennis-admin-db",
    "d1:migrate": "wrangler d1 migrations apply tennis-admin-db --local",
    "d1:migrate:local": "wrangler d1 migrations apply tennis-admin-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply tennis-admin-db --remote",
    "d1:site-settings:local": "wrangler d1 execute tennis-admin-db --local --file=../../db/migrations/0015_site_settings.sql"
  },
  "devDependencies": {
    "wrangler": "^3.78.0"
  }
}
